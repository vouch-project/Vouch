SERVER_HOST=localhost

# Supabase (server-side — used by apps/api)
SUPABASE_URL=http://localhost:54321
SUPABASE_SECRET_KEY=your-secret-key

# JWT signing — local dev uses symmetric HS256 (JWT_SECRET).
# Production/remote Supabase uses asymmetric ES256 (ECC P-256): set paths to PEM key files.
# (generate a key pair locally, upload the public key to Supabase Dashboard → Settings → Auth → JWT Signing Keys)
# Note: docker-compose.yml currently requires SUPABASE_EC_*_KEY_PATH to be set (host paths) for bind mounts;
# inside the container, the API reads keys from /run/secrets/supabase_ec_{private,public}.pem.
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
# SUPABASE_EC_PRIVATE_KEY_PATH=/path/on/host/to/supabase_ec_private.pem
# SUPABASE_EC_PUBLIC_KEY_PATH=/path/on/host/to/supabase_ec_public.pem

# Supabase (client-exposed — used by apps/web, PUBLIC_ prefix required by SvelteKit)
PUBLIC_SUPABASE_URL=http://localhost:54321
PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Reown / Web3Modal (client-exposed — used by apps/web)
PUBLIC_REOWN_PROJECT_ID=your-reown-project-id

# Database (direct connection — used by API/migrations)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# ML Engine (used by apps/api to call the Python scoring service)
ML_ENGINE_URL=http://localhost:8001

# PriceFeedService poll interval (ms). RPC URLs are read per-chain from the `chains` table.
PRICE_FEED_INTERVAL_MS=60000

# ML Engine — on-chain data sources (used by apps/ml-engine)
THE_GRAPH_API_KEY=your-the-graph-api-key
AAVE_V3_SUBGRAPH_ID=your-aave-v3-subgraph-id
ETHERSCAN_API_KEY=your-etherscan-api-key
RPC_URL=https://mainnet.infura.io/v3/your-infura-key

# Protocol fee configuration (used by packages/contracts deploy script)
# PROTOCOL_TREASURY_ADDRESS: wallet that receives protocol fees (defaults to deployer if unset)
# PROTOCOL_FEE_BPS: fee taken from loan interest, in basis points (1000 = 10%, max 5000 = 50%)
PROTOCOL_TREASURY_ADDRESS=
PROTOCOL_FEE_BPS=1000

# Testnet deployment (used by packages/contracts hardhat.config.ts / deploy script)
# SEPOLIA_RPC_URL: JSON-RPC endpoint for the Sepolia network (Infura/Alchemy/public)
# DEPLOYER_PRIVATE_KEY: 0x-prefixed 32-byte hex private key of a funded Sepolia account used to deploy
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your-infura-key
DEPLOYER_PRIVATE_KEY=
