{
  "name": "@vouch/contracts",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "dev": "concurrently \"hardhat node\" \"sleep 10s && bash ./dev-setup.sh\"",
    "build": "hardhat compile && node scripts/extract-abi.mjs && tsc -p tsconfig.build.json && tsc -p tsconfig.build.esm.json && echo '{\"type\":\"module\"}' > dist/esm/package.json",
    "build:types": "tsc -p tsconfig.build.json && tsc -p tsconfig.build.esm.json && echo '{\"type\":\"module\"}' > dist/esm/package.json",
    "test": "hardhat test",
    "clean": "hardhat clean"
  },
  "devDependencies": {
    "@chainlink/contracts": "^1.5.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/hardhat-upgrades": "^3.9.1",
    "@types/pg": "^8.20.0",
    "concurrently": "^8.2.2",
    "dotenv": "^17.2.3",
    "ethers": "^6.14.0",
    "hardhat": "^2.22.0",
    "pg": "^8.11.3",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/contracts-upgradeable": "^5.6.1"
  }
}
