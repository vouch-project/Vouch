# --- Aave V3 subgraph (The Graph decentralized network) ---
# Get an API key at https://thegraph.com/studio/apikeys/
THE_GRAPH_API_KEY=your-graph-api-key
# Aave V3 Ethereum mainnet subgraph id (verify on thegraph.com/explorer)
AAVE_V3_SUBGRAPH_ID=Cd2gEDVeqnjBn1hSeqFMitw8Q1iiyV9FYUZkLNRcL87g
# Chain id for the wallets you're scraping (1 = mainnet, 11155111 = sepolia)
TARGET_CHAIN_ID=1

# --- Etherscan v2 multichain API ---
# https://etherscan.io/apidashboard
ETHERSCAN_API_KEY=your-etherscan-key

# --- RPC (used for nonce, balances, latest block) ---
# Use Alchemy / Infura / your own node
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-key

# --- Supabase (service role; bypasses RLS) ---
SUPABASE_URL=http://localhost:54321
SUPABASE_SECRET_KEY=your-service-role-key

# --- ETL knobs ---
TARGET_RISKY_WALLETS=2000
TARGET_SAFE_WALLETS=2000
HTTP_CONCURRENCY=4
ETHERSCAN_RPS=4
FEATURE_SET_VERSION=cold_start_v1
OBSERVATION_WINDOW_DAYS=90
